constant name : $(name)/sdv1 ;

echo "Build $(name) ..." ;

lib boost_filesystem ;
lib boost_process ;
alias deps : boost_filesystem boost_process ;

exe sdv1 : sdv1.cpp : <library>deps ;

install
	install
:
	sdv1
:
	<location>$(prefix)/bin/
;
explicit install ;

