constant name : $(name)/pptg ;

echo "Build $(name) ..." ;

exe pptg : pptg.cpp ;

exe ipptg : ipptg.cpp ;

install
	install
:
	pptg
	ipptg
:
	<location>$(prefix)/bin/
;
explicit install ;

