constant name : $(name)/askit ;

echo "Build $(name) ..." ;

path-constant askit-src-dir : . ;

if [ MATCH ^(cleanall)$ : [ modules.peek : ARGV ] ]
{
	echo "cleanall ..." ;
	cmd = "rm -rf `find $(askit-src-dir) -name bin`" ;
	echo $(cmd) ;
	SHELL $(cmd) ;
	exit ;
}

project
	$(name)
:
	default-build
		<cxxstd>26
;

projects =
	sdv1
	sopv
	asidt
	dmm
	dperm
;

for prj in $(projects)
{
	build-project $(prj) ;
}

rule get-prefix ( )
{
	local prefix = [ option.get prefix ] ;
	if ! $(prefix)
	{
		return /usr/local ;
	}
	else
	{
		return $(prefix) ;
	}
}

constant prefix : [ get-prefix ] ;

echo "prefix => $(prefix)" ;

alias
	install
:
	$(projects)//install
;
explicit install ;

