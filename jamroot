constant name : askit ;

echo "Build $(name) ..." ;

################################

path-constant askit-project-dir : . ;

if [ MATCH ^(cleanall)$ : [ modules.peek : ARGV ] ]
{
	echo "cleanall ..." ;
	cmd = "rm -rf `find $(askit-project-dir) -name bin`" ;
	echo $(cmd) ;
	SHELL $(cmd) ;
	exit ;
}

################################

build-project askit ;

alias install : ./askit//install ;
explicit install ;

